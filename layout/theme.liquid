<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:{{ settings.color_text }};
      --accent:{{ settings.color_button }};
      --accent-text:{{ settings.color_button_text }};
      --blush:{{ settings.color_accent }};
      --paper:{{ settings.color_background }};
      --paper-soft:{{ settings.color_background_soft }};
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>window.theme = { moneyFormat: {{ shop.money_format | json }}, cartUrl: {{ routes.cart_url | json }}, rootUrl: {{ routes.root_url | json }} };</script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}
  <div class="toast" id="Toast" role="status" aria-live="polite"></div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
