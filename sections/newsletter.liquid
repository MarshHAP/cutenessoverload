<section class="newsletter">
  <div class="container newsletter__inner">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% form 'customer', class: 'newsletter__form', id: 'NewsletterForm' %}
      {% if form.posted_successfully? %}
        <p class="newsletter__thanks">{{ 'newsletter.success' | t }}</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr-only" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required autocomplete="email">
        <button class="btn btn--primary" type="submit">{{ 'newsletter.submit' | t }}</button>
        {% if form.errors %}<p class="form-error">{{ form.errors | default_errors }}</p>{% endif %}
      {% endif %}
    {% endform %}
    {% if section.settings.small != blank %}<p class="newsletter__small">{{ section.settings.small }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little updates, straight to your inbox" },
    { "type": "text", "id": "text", "label": "Text", "default": "New arrivals, early access to sales and the occasional very cute photo." },
    { "type": "text", "id": "small", "label": "Small print", "default": "By signing up you agree to our terms and privacy policy. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
