{%- liquid
  assign featured = product
  if section.settings.product != blank
    assign featured = section.settings.product
  endif
  if featured == blank
    assign featured = collections.all.products.first
  endif
-%}

{% if featured == blank %}
  <section class="container empty-state">
    <h1>Add your first product</h1>
    <p>Create a product in the Shopify admin, then pick it in the theme editor under this section's settings. It will appear here as the one-page store.</p>
  </section>
{% else %}

{%- liquid
  assign current_variant = featured.selected_or_first_available_variant
  assign require_size = section.settings.require_size_selection
  assign colour_index = -1
  for option in featured.options_with_values
    assign oname = option.name | downcase
    if oname == 'colour' or oname == 'color'
      assign colour_index = option.position | minus: 1
    endif
  endfor
-%}

{% if section.settings.show_breadcrumb %}
<nav class="breadcrumb container" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {% if featured.collections.first %}
      <li><a href="{{ featured.collections.first.url }}">{{ featured.collections.first.title }}</a></li>
    {% endif %}
    <li aria-current="page">{{ featured.title }}</li>
  </ol>
</nav>
{% endif %}

<section class="product container" data-product-section data-section-id="{{ section.id }}">

  <div class="gallery" data-gallery>
    <div class="gallery__main">
      {% if featured.media.size > 1 %}
        <button type="button" class="gallery__arrow gallery__arrow--prev" aria-label="Previous image" data-gallery-prev>‹</button>
      {% endif %}
      <div class="gallery__figure">
        {% for media in featured.media %}
          {%- if forloop.first %}{% assign loading = 'eager' %}{% else %}{% assign loading = 'lazy' %}{% endif -%}
          <div class="gallery__slide" data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
            {% if media.media_type == 'image' %}
              {{ media | image_url: width: 1400 | image_tag: loading: loading, sizes: '(min-width: 900px) 58vw, 100vw', widths: '600, 900, 1200, 1400', class: 'gallery__img' }}
            {% else %}
              {{ media | media_tag }}
            {% endif %}
          </div>
        {% endfor %}
        {% if featured.media.size == 0 %}
          <div class="gallery__slide">{{ 'product-apparel-1' | placeholder_svg_tag: 'gallery__placeholder' }}</div>
        {% endif %}
      </div>
      {% if featured.media.size > 1 %}
        <button type="button" class="gallery__arrow gallery__arrow--next" aria-label="Next image" data-gallery-next>›</button>
      {% endif %}
    </div>
    {% if featured.media.size > 1 %}
      <div class="gallery__thumbs" role="tablist" aria-label="Product images" data-gallery-thumbs>
        {% for media in featured.media %}
          <button type="button" class="thumb" role="tab" aria-selected="{{ forloop.first }}" aria-label="Image {{ forloop.index }}" data-media-id="{{ media.id }}">
            {{ media | image_url: width: 200 | image_tag: loading: 'lazy' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="info">
    {% if featured.tags contains 'new' or featured.tags contains 'New' %}<span class="tag">New</span>{% endif %}
    <h1 class="info__title">{{ featured.title }}</h1>
    <p class="info__price" data-price>
      {% if current_variant.compare_at_price > current_variant.price %}<s data-compare-price>{{ current_variant.compare_at_price | money }}</s> {% endif %}
      <span data-current-price>{{ current_variant.price | money }}</span>
    </p>

    {% form 'product', featured, id: 'ProductForm', class: 'product-form', data-product-form: '' %}
      {% unless featured.has_only_default_variant %}
        {% for option in featured.options_with_values %}
          {%- assign idx = option.position | minus: 1 -%}
          {%- assign oname = option.name | downcase -%}
          {%- assign selected_value = current_variant.options[idx] -%}
          <div class="field" data-option-index="{{ idx }}">
            {% if idx == colour_index %}
              <div class="field__label">{{ option.name }}: <strong data-selected-colour>{{ selected_value }}</strong></div>
              <div class="swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                {% for value in option.values %}
                  {%- assign swatch_media = blank -%}
                  {%- for v in featured.variants -%}
                    {%- if v.options[idx] == value and v.featured_media != blank -%}{%- assign swatch_media = v.featured_media -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  <button type="button" class="swatch" role="radio" aria-checked="{% if value == selected_value %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" title="{{ value | escape }}" data-option-value="{{ value | escape }}">
                    {% if section.settings.swatch_from_image and swatch_media != blank %}
                      <span style="background-image:url({{ swatch_media | image_url: width: 80 }})"></span>
                    {% else %}
                      <span style="background:{% render 'swatch-color', value: value %}"></span>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            {% else %}
              <label class="field__label" for="Option-{{ section.id }}-{{ idx }}">{{ option.name }}</label>
              <div class="select-wrap">
                <select id="Option-{{ section.id }}-{{ idx }}" data-option-select>
                  {% if require_size %}<option value="" selected>{{ 'products.select_size' | t }}</option>{% endif %}
                  {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if require_size == false and value == selected_value %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </div>
              {% if section.settings.size_guide_anchor != blank %}<a href="{{ section.settings.size_guide_anchor }}" class="field__link">{{ 'products.size_guide' | t }}</a>{% endif %}
            {% endif %}
          </div>
        {% endfor %}
      {% endunless %}

      <div class="field field--qty">
        <label class="field__label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
        <div class="qty">
          <button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button>
          <input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" max="10" value="1" inputmode="numeric">
          <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <p class="form-error" data-form-error hidden>{{ 'products.select_size' | t }}</p>

      <input type="hidden" name="id" value="{% unless require_size and featured.has_only_default_variant == false %}{{ current_variant.id }}{% endunless %}" data-variant-id>

      <div class="cta-row">
        <button type="submit" name="add" class="btn btn--primary" data-add-to-cart {% unless featured.available %}disabled{% endunless %}>
          <span data-add-text>{% if featured.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
        </button>
        <button type="button" class="btn btn--icon" aria-label="{{ 'products.save' | t }}" aria-pressed="false" data-wishlist-toggle data-product-id="{{ featured.id }}">
          <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
        </button>
      </div>
    {% endform %}

    {% if section.settings.stock_note != blank %}<p class="stock-note" data-stock-note>{{ section.settings.stock_note }}</p>{% endif %}
    {% if section.settings.stock_link_text != blank %}<a href="{{ section.settings.stock_link_url | default: '#' }}" class="field__link">{{ section.settings.stock_link_text }}</a>{% endif %}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'features' %}
          {% if block.settings.items != blank %}
            <ul class="features" {{ block.shopify_attributes }}>
              {% assign items = block.settings.items | newline_to_br | split: '<br />' %}
              {% for item in items %}{% if item != blank %}<li>{{ item | strip }}</li>{% endif %}{% endfor %}
            </ul>
          {% endif %}
      {% endcase %}
    {% endfor %}

    <div class="accordion">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'description' %}
            <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="accordion__body rte">{{ featured.description }}</div>
            </details>
          {% when 'text' %}
            <details {% if block.settings.open %}open{% endif %} id="{{ block.settings.anchor }}" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="accordion__body rte">
                {{ block.settings.content }}
                {% if block.settings.table != blank %}
                  {% assign rows = block.settings.table | newline_to_br | split: '<br />' %}
                  {% assign head_cells = rows[0] | strip | split: '|' %}
                  <table class="size-table">
                    <thead>
                      <tr>{% for cell in head_cells %}<th>{{ cell | strip }}</th>{% endfor %}</tr>
                    </thead>
                    <tbody>
                      {% for row in rows offset: 1 %}
                        {% assign cells = row | strip | split: '|' %}
                        <tr>{% for cell in cells %}<td>{{ cell | strip }}</td>{% endfor %}</tr>
                      {% endfor %}
                    </tbody>
                  </table>
                {% endif %}
              </div>
            </details>
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  <script type="application/json" data-product-json>{{ featured | json }}</script>
  <script type="application/json" data-product-config>{ "requireSelection": {{ require_size | json }}, "colourIndex": {{ colour_index }} }</script>
</section>
{% endif %}

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Used on the home page. On product pages the current product is shown." },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "require_size_selection", "label": "Ask the customer to choose a size before adding", "default": true },
    { "type": "checkbox", "id": "swatch_from_image", "label": "Use the variant image as the colour swatch", "default": true },
    { "type": "text", "id": "size_guide_anchor", "label": "Size guide link", "default": "#materials" },
    { "type": "text", "id": "stock_note", "label": "Stock note", "default": "In stock — dispatched within 1–2 working days." },
    { "type": "text", "id": "stock_link_text", "label": "Stock link text", "default": "Check stock in store" },
    { "type": "url", "id": "stock_link_url", "label": "Stock link URL" }
  ],
  "blocks": [
    {
      "type": "features",
      "name": "Feature bullets",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "items", "label": "One feature per line", "default": "Ultra-soft, brushed teddy fleece outer\nLined in soft cotton jersey\nFront zip for quick changes\nHood with little ears\nEnclosed feet to keep toes warm" }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What we love" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Standard UK delivery in 3–5 working days, free over £50. Return unworn items within 30 days for a full refund.</p>" },
        { "type": "textarea", "id": "table", "label": "Optional table", "info": "One row per line, cells separated by |. The first line is the header." },
        { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets links such as #materials jump here." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "features" },
      { "type": "description" },
      { "type": "text", "settings": { "heading": "Materials, care & size", "anchor": "materials", "content": "<p>Outer: recycled polyester teddy fleece. Lining: organic cotton jersey.</p><p>Machine wash at 30°C with similar colours. Do not tumble dry. Reshape while damp.</p>", "table": "Size | Height (cm) | Weight (kg)\nNewborn | up to 56 | up to 4.5\n0–3 months | 56–62 | 4.5–6\n3–6 months | 62–68 | 6–8\n6–12 months | 68–80 | 8–11\n12–18 months | 80–86 | 11–12.5\n18–24 months | 86–92 | 12.5–14" } },
      { "type": "text", "settings": { "heading": "Sustainability", "content": "<p>The fleece is made from recycled plastic bottles and the lining is certified organic cotton. Every order ships in recyclable packaging.</p>" } },
      { "type": "text", "settings": { "heading": "Delivery & returns", "anchor": "delivery", "content": "<p><strong>Standard UK delivery</strong> (3–5 working days): £3.95, free over £50.<br><strong>Next-day UK delivery</strong>: £5.95, order before 8pm.<br><strong>International</strong>: from £9.95, 5–10 working days.</p><p>Not quite right? Return unworn items within 30 days for a full refund.</p>" } }
    ]
  },
  "presets": [{ "name": "Product page" }]
}
{% endschema %}
