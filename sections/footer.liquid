<footer class="footer" id="footer">
  <div class="container footer__cols">
    <div class="footer__col footer__col--brand">
      <p class="footer__brand">{{ shop.name }}</p>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      {% if section.settings.badge != blank %}<span class="footer__badge">{{ section.settings.badge }}</span>{% endif %}
      <div class="social" aria-label="Social media">
        {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" aria-label="Instagram">IG</a>{% endif %}
        {% if settings.social_pinterest != blank %}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest">PN</a>{% endif %}
        {% if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}" aria-label="Facebook">FB</a>{% endif %}
        {% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">TT</a>{% endif %}
        {% if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}" aria-label="YouTube">YT</a>{% endif %}
        {% if settings.social_x != blank %}<a href="{{ settings.social_x }}" aria-label="X">X</a>{% endif %}
      </div>
    </div>
    {% for block in section.blocks %}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
        <ul>
          {% for link in linklists[block.settings.menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
  <div class="container footer__legal">
    <ul>
      {% for policy in shop.policies %}
        {% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{% endif %}
      {% endfor %}
    </ul>
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="payments" aria-label="Accepted payment methods">
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag: class: 'payments__icon' }}
      {% endfor %}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "text", "label": "About text", "default": "Thoughtfully made baby clothing that is soft on skin and easy on parents. Designed with love, made in small batches." },
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Certified organic cotton" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shopping online" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shopping online", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "About us", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Simpler shopping", "menu": "footer" } }
    ]
  }
}
{% endschema %}
