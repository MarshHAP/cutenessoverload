<section class="shelf container page-top">
  <h1 class="shelf__title">{{ collection.title }}</h1>
  {% if collection.description != blank %}<div class="rte page-intro">{{ collection.description }}</div>{% endif %}
  {% paginate collection.products by 24 %}
    <div class="grid">
      {% for card_product in collection.products %}
        {% render 'product-card', card_product: card_product %}
      {% else %}
        <p>No products here yet.</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
