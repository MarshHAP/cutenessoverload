<section class="container page-top page-narrow password" style="text-align:center">
  <p class="logo" style="display:block;margin-bottom:24px">{{ shop.name }}</p>
  <h1 class="shelf__title">{{ section.settings.heading }}</h1>
  {% if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif %}
  {% form 'storefront_password', class: 'newsletter__form' %}
    <label class="sr-only" for="Password">Password</label>
    <input id="Password" type="password" name="password" placeholder="Enter store password">
    <button type="submit" class="btn btn--primary">Enter</button>
    {% if form.errors %}<p class="form-error">{{ form.errors | default_errors }}</p>{% endif %}
  {% endform %}
</section>
{% schema %}
{ "name": "Password", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" } ] }
{% endschema %}
