<section class="shelf container page-top">
  <h1 class="shelf__title">{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form search-form">
    <input type="hidden" name="type" value="product">
    <label class="sr-only" for="SearchInput">{{ 'general.search' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
    <button type="submit" class="btn btn--primary">{{ 'general.search' | t }}</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      {% if search.results_count == 0 %}
        <p style="text-align:center">No results for “{{ search.terms | escape }}”.</p>
      {% else %}
        <div class="grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
