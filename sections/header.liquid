<header class="header" data-header>
  <div class="container header__inner">
    <button type="button" class="icon-btn header__menu-toggle" aria-label="Menu" aria-expanded="false" data-menu-toggle>
      <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if section.settings.logo != blank %}
        {%- assign logo_style = 'max-width:' | append: section.settings.logo_width | append: 'px' -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo__img', style: logo_style }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <nav class="nav" aria-label="Main" data-nav>
      <ul>
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}" {% if link.title contains 'Sale' %}class="nav__sale"{% endif %}>{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header__icons">
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </a>
      <button type="button" class="icon-btn" aria-label="Saved items" data-wishlist-button>
        <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
        <span class="badge" data-wishlist-count hidden>0</span>
      </button>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Shopping bag" data-cart-open>
        <svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="badge" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 200 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
