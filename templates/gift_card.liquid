{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} gift card</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="container" style="padding:64px 24px;text-align:center">
    <h1>Gift card</h1>
    <p>Here is your {{ shop.name }} gift card for {{ gift_card.initial_value | money }}.</p>
    <p class="gift-code">{{ gift_card.code | format_code }}</p>
    {% if gift_card.expired %}<p>This gift card has expired.</p>{% endif %}
    <a class="btn btn--primary" href="{{ shop.url }}">Shop now</a>
  </main>
</body>
</html>
